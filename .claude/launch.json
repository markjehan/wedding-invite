{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nw-invitation",
      "runtimeExecutable": "python",
      "runtimeArgs": ["serve.py"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "nw-server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
